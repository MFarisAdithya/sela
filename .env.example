# FATHERCARE AI - Environment Configuration Example
# Salin file ini menjadi .env.local untuk konfigurasi lokal

# Mode Operasi AI (Bila kosong, sistem otomatis berjalan dalam MODE DEMO SIMULASI)
OPENAI_API_KEY=your_openai_api_key_here

# Model yang digunakan (Default: gpt-4o-mini untuk efisiensi latensi dan biaya)
OPENAI_MODEL=gpt-4o-mini

# URL Aplikasi (Opsional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
