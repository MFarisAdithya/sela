# =================================================================
# SELA.AI — AI-Powered Help-Seeking Navigator
# Template Konfigurasi Environment & Sandbox
# =================================================================

# 1. Google Gemini AI (Server-Side Only — Jangan pernah diekspos ke browser)
# Dapatkan API Key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=60000

# 2. Gerbang Pembayaran Sandbox (Midtrans Snap)
# Kredensial akun Sandbox Midtrans: https://dashboard.sandbox.midtrans.com/
# Jika dikosongkan, platform otomatis berjalan dalam mode "SELA Sandbox Payment Simulator"
PAYMENT_PROVIDER=midtrans
PAYMENT_MODE=sandbox
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# 3. Konfigurasi Aplikasi & Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
