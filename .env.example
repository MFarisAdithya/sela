# ========================================================
# FATHERCARE AI - Konfigurasi Model AI (Pilih Salah Satu)
# ========================================================

# Pilihan 1: Mode Gratis Bebas Biaya (Tanpa Perlu Kunci API / Default)
AI_PROVIDER=free

# Pilihan 2: Google Gemini (Gratis Resmi 15 RPM / 1.500 respons per hari)
# Dapatkan gratis di: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# Pilihan 3: Groq Cloud (Gratis Resmi 30 RPM / Sangat Cepat)
# Dapatkan gratis di: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Pilihan 4: OpenAI API Resmi (Berbayar / Berbasis Saldo)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
