# =================================================================
# FATHERCARE AI - Konfigurasi Google Gemini API & Model Lingkungan
# =================================================================

# Kunci API Google Gemini (Dapatkan gratis di https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Teks Google Gemini (Rekomendasi: gemini-flash-lite-latest atau gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-flash-lite-latest

# Model Semantic Embeddings RAG (Rekomendasi: gemini-embedding-2)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
