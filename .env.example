# =================================================================
# SELA - Konfigurasi Google Gemini API & Model Lingkungan
# =================================================================

# Kunci API Google Gemini (Dapatkan gratis di https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Teks Google Gemini (Rekomendasi: gemini-3.5-flash-lite atau gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.5-flash-lite

# Batas Waktu Permintaan API (dalam milidetik, rekomendasi: 60000)
GEMINI_TIMEOUT_MS=60000

# Model Semantic Embeddings RAG (Rekomendasi: gemini-embedding-2)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
